@font-face {
 font-family: 'CoolveticaLT-RG';
 src: url('../../webfonts/CoolveticaLt-Regular.woff2') format('truetype');
}

::-webkit-scrollbar {
 display: none;
}

button {
 font-family: 'CoolveticaLT-RG';
}

#logo-image {
 grid-area: image;
 font-weight: 500;
 display: grid;
 height: 80px;
}

#logo-style {
 grid-area: logo;
 font-weight: 500;
 display: grid;
 grid-template-areas:
  "logo-top"
  "logo-bottom";
 grid-template-rows: 40px 40px;
 margin: 0;
}

.opac {
	transition: opacity 1s linear(0 0%, 0 2.27%, 0.02 4.53%, 0.04 6.8%, 0.06 9.07%, 0.1 11.33%, 0.14 13.6%, 0.25 18.15%, 0.39 22.7%, 0.56 27.25%, 0.77 31.8%, 1 36.35%, 0.89 40.9%, 0.85 43.18%, 0.81 45.45%, 0.79 47.72%, 0.77 50%, 0.75 52.27%, 0.75 54.55%, 0.75 56.82%, 0.77 59.1%, 0.79 61.38%, 0.81 63.65%, 0.85 65.93%, 0.89 68.2%, 1 72.7%, 0.97 74.98%, 0.95 77.25%, 0.94 79.53%, 0.94 81.8%, 0.94 84.08%, 0.95 86.35%, 0.97 88.63%, 1 90.9%, 0.99 93.18%, 0.98 95.45%, 0.99 97.73%, 1 100%);
}

.logotkr {
 width: auto;
 vertical-align: middle;
 display: inline-block;
 z-index: -10;
 justify-self: anchor-center;
 height: 80px;
 margin-top: 0px;
}

form {
 display:flex;
 flex-direction:column;
 margin:0;
 padding:0;
}

.checkbox,
.radio,
input[type=text],
select,
textarea {
 border:1px solid rgba(255,255,255,0.05);
 border-radius:0.5rem;
 box-sizing:border-box
}

input[type=text],
select,
textarea {
 color:rgba(255,255,255,0.9);
 font:inherit;
 line-height:1em
}

input[type=text],
select,
textarea {
 padding:0.5rem;
}

input[type=text]::placeholder,
select::placeholder,
textarea::placeholder {
 color:rgba(255,255,255,0.5)
}

textarea {
 line-height:1.5em;
 max-width:600px
}

.cover,
.sidebars .item a .icon,
.sidebars .item a:visited .icon,
.featured .container .item,
.tiles li a .image,
.admin .thumb {
 background-position:center;
 background-repeat:no-repeat;
 background-size:cover
}

html,
body {
 scrollbar-width: none;
 -ms-overflow-style: none;
 background-color:#1d1d1d;
 color:rgba(255,255,255,0.9);
 font-family: "CoolveticaLT-RG";
 font-weight: 1000;
 font-size:16px;
 margin:0;
 padding:0;
 min-width:100%;
 min-height:100%;
 width:100%;
 height:100%;
 overflow-y: hidden;
 overflow-x: hidden;
}

h1,
h2,
h3,
h4,
h5,
h6 {
 margin:0;
 padding:0
}

a,
a:visited,
a:hover {
 color:rgba(255,255,255,0.9);
 text-decoration:none
}

a.href,
a.href:visited {
 color:#0df
}

.inline-block {
 display:inline-block
}

.text {
 line-height:1.5em
}

.text-center {
 text-align:center
}

.block {
 margin:1rem
}

.sidebars {
 white-space:nowrap;
 height: 100%;
}

.sidebars .header {
 /* color: #fc0; */
 font-size: 1.25rem;
 font-weight: bold;
 padding: 1.5rem 1rem 0.5rem 1rem;
 -webkit-background-clip: text;
 /* display: none; */
 background-size: 200px 100%; /* Fixed width, adjust as needed */
 background-repeat: no-repeat;
 font-weight: bold;
}

.scroll-y,
body aside,
body .main,
body .chat-messages,
.admin main {
 overflow-y:scroll;
 scrollbar-color:transparent rgba(255,255,255,0.05);
 scrollbar-width:none
}

body nav {
 grid-area:nav;
 display:grid;
 align-items:center;
}

body nav .logo {
 grid-area:logo
}

body nav .menu {
 grid-area:menu
}

body .main {
 overflow: hidden;
 z-index: 0;
 grid-area: main;
 /* display: flex; */
 flex-direction: column;
}

h1 {
 font-size:3rem
}

.logo {
 font-size:1.5rem;
 font-weight:bold
}

.logo a .anarchychats,
.logo a:visited .anarchychats {
 color:rgba(255,255,255,0.9)
}

.logo a .com,
.logo a:visited .com {
 color:#ff9999;
}

.blur {
 backdrop-filter: blur(9px);
 opacity: 100%;
 background-color: rgba(26, 27, 30, 0.6);
}

.button.list.opac a {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50px;    /* Fixed width */
  height: 50px;   /* Fixed height */
}

#hoverButton {
 padding: 5px;
 border-radius: 5px;
 vertical-align: middle;
 display: inline-block;
 user-select: none;
}

.hoverButton {
 padding: 5px;
 border-radius: 5px;
 vertical-align: middle;
 display: inline-block;
 user-select: none;
}

.performanceMode {
 position: absolute;
 right: 40px;
 z-index: 100;
 width: 248px;
 background-color: green;
 padding: 17px;
 border-radius: 100px;
 width: 275px;
 box-shadow: 4px 4px 8px 0 rgba(0, 0, 0, 0.4);
 transition: bottom 0.35s ease;
 bottom: -100%;
}

.performanceMode.active {
 bottom: 40px;
 transition: bottom 0.35s ease;
 overflow-y: hidden;
 overflow-x: hidden;
}

#navbar {
 width: 100%;
 grid-area: nav;
 display: grid;
 grid-template-areas:
  "logo image button";
 grid-template-columns: 225px auto 225px;
 grid-template-rows: 80px;
 align-items: center;
 height: 80px;
 z-index: 100;
}

#gridLayer {
 display: grid;
 grid-template-areas:
  "nav nav"
  "sidebar mid"
  "sidebar mid"
  "sidebar mid";
 grid-template-columns: 50px auto;
 grid-template-rows: auto auto 1fr auto;
 height: 100%;
 width: 100%;
}

.titleName {
 font-size: 20px;
 font-weight: bold;
}
.subTitleName {
 font-size: 15px;
}

html {
    overflow: hidden;
}

* {
  box-sizing: border-box;
}

html, body {
  height: 100%;
  margin: 0;
  padding: 0;
}
